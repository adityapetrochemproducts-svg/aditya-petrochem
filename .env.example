# ---------------------------------------------------------------------------
# Aditya Petrochem — environment configuration
# Copy this file to .env.local (development) or configure these as real
# environment variables in your hosting provider (production).
# Never commit .env.local or any file containing real credentials.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.adityapetrochem.com

# ---------------------------------------------------------------------------
# Email notifications (enquiry form)
# Uses SMTP via Nodemailer. Works with any transactional SMTP provider:
# Gmail Workspace, Zoho Mail, Amazon SES, SendGrid SMTP, Mailgun SMTP, etc.
# ---------------------------------------------------------------------------

# Address enquiries are sent FROM (must generally be a verified/authorized
# address for your SMTP provider)
EMAIL_FROM="Aditya Petrochem Website <no-reply@adityapetrochem.com>"

# Address (or comma-separated addresses) enquiries are delivered TO
EMAIL_TO=sales@adityapetrochem.com

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# ---------------------------------------------------------------------------
# Basic anti-spam / abuse protection for /api/enquiry
# ---------------------------------------------------------------------------

# Max enquiry submissions allowed per IP address within the rate limit window
ENQUIRY_RATE_LIMIT_MAX=5
# Rate limit window in seconds
ENQUIRY_RATE_LIMIT_WINDOW=600
